<div style="max-width: 450px; margin: 3rem auto;">
  <div class="card">
    <h1 style="color: var(--primary); font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; text-align: center;">
      Neues Passwort vergeben
    </h1>
    <p style="color: var(--text-muted); font-size: 0.9rem; text-align: center; margin-bottom: 1.5rem;">
      <%= roleName %>-Passwort für <%= schoolName %>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form action="/auth/<%= role %>/passwort-zuruecksetzen" method="POST">
      <input type="hidden" name="token" value="<%= token %>">

      <div class="form-group">
        <label for="new_password">Neues Passwort *</label>
        <input type="password" id="new_password" name="new_password" class="form-control" required autofocus placeholder="Mindestens 6 Zeichen">
      </div>

      <div class="form-group">
        <label for="new_password_confirm">Neues Passwort (Wiederholung) *</label>
        <input type="password" id="new_password_confirm" name="new_password_confirm" class="form-control" required placeholder="Passwort wiederholen">
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Neues Passwort speichern &rarr;
        </button>
      </div>
    </form>
  </div>
</div>
