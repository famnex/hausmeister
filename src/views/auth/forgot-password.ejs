<div style="max-width: 450px; margin: 3rem auto;">
  <div class="card">
    <h1 style="color: var(--primary); font-size: 1.4rem; font-weight: 700; margin-bottom: 0.5rem; text-align: center;">
      Passwort vergessen (<%= roleName %>)
    </h1>
    <p style="color: var(--text-muted); font-size: 0.9rem; text-align: center; margin-bottom: 1.5rem;">
      Veranlasse ein neues Passwort für den <%= roleName %>-Zugang der <%= schoolName %>.
    </p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } else { %>
      <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">
        Ein sicherer Link zum Zurücksetzen wird an die im System hinterlegte E-Mail-Adresse gesendet.
      </p>

      <form action="<%= url('/auth/' + role + '/passwort-vergessen') %>" method="POST">
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Reset-Link jetzt anfordern &rarr;
        </button>
      </form>
    <% } %>

    <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem;">
      <a href="<%= url('/' + (role === 'admin' ? 'admin' : 'hausmeister') + '/login') %>" style="color: var(--text-muted); text-decoration: underline;">
        &larr; Zurück zum Login
      </a>
    </div>
  </div>
</div>
