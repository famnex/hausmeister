<div style="max-width: 500px; margin: 0 auto;">
  <div style="margin-bottom: 1rem;">
    <a href="/hausmeister" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">&larr; Zurück zum Dashboard</a>
  </div>

  <div class="card">
    <h1 style="color: var(--primary); font-size: 1.4rem; font-weight: 700; margin-bottom: 1rem;">
      Hausmeister-Passwort ändern
    </h1>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (successMessage) { %>
      <div class="alert alert-success"><%= successMessage %></div>
    <% } %>

    <form action="/hausmeister/passwort" method="POST">
      <div class="form-group">
        <label for="current_password">Aktuelles Hausmeister-Passwort *</label>
        <input type="password" id="current_password" name="current_password" class="form-control" required placeholder="Aktuelles Passwort">
      </div>

      <div class="form-group">
        <label for="new_password">Neues Passwort *</label>
        <input type="password" id="new_password" name="new_password" class="form-control" required placeholder="Mindestens 6 Zeichen">
      </div>

      <div class="form-group">
        <label for="new_password_confirm">Neues Passwort (Wiederholung) *</label>
        <input type="password" id="new_password_confirm" name="new_password_confirm" class="form-control" required placeholder="Neues Passwort bestätigen">
      </div>

      <div style="margin-top: 1.5rem;">
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Passwort jetzt aktualisieren
        </button>
      </div>
    </form>
  </div>
</div>
