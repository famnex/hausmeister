<div>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 style="color: var(--primary); font-size: 1.5rem; font-weight: 700;">Hausmeister Dashboard</h1>
      <p style="color: var(--text-muted); font-size: 0.9rem;">Alle Schadensmeldungen im Überblick</p>
    </div>
    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center;">
      <!-- Active / Closed Toggle -->
      <div class="view-toggle" style="display: flex; border: 1px solid var(--border); border-radius: 8px; overflow: hidden;">
        <a href="<%= url('/hausmeister/dashboard') %>?view=active<%= filters.category_id ? '&category_id=' + filters.category_id : '' %><%= filters.employee_id ? '&employee_id=' + filters.employee_id : '' %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
           style="padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: background 0.15s;
                  background: <%= !showClosed ? 'var(--primary)' : 'var(--bg-card)' %>;
                  color: <%= !showClosed ? '#fff' : 'var(--text-main)' %>;">
          Aktiv (<%= stats.open + stats.inProgress %>)
        </a>
        <a href="<%= url('/hausmeister/dashboard') %>?view=closed<%= filters.category_id ? '&category_id=' + filters.category_id : '' %><%= filters.employee_id ? '&employee_id=' + filters.employee_id : '' %><%= filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
           style="padding: 0.5rem 1rem; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: background 0.15s;
                  background: <%= showClosed ? 'var(--success)' : 'var(--bg-card)' %>;
                  color: <%= showClosed ? '#fff' : 'var(--text-main)' %>;">
          Abgeschlossen (<%= stats.closed %>)
        </a>
      </div>

      <a href="<%= url('/hausmeister/categories') %>" class="btn btn-secondary btn-sm">Kategorien</a>
      <a href="<%= url('/hausmeister/employees') %>" class="btn btn-secondary btn-sm">Mitarbeiter</a>
    </div>
  </div>

  <% if (successMessage) { %>
    <div class="alert alert-success"><%= successMessage %></div>
  <% } %>

  <!-- Statistics -->
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-number" style="color: var(--warning);"><%= stats.open %></span>
      <span class="stat-label">Offene Tickets</span>
    </div>
    <div class="stat-card">
      <span class="stat-number" style="color: var(--primary);"><%= stats.inProgress %></span>
      <span class="stat-label">In Bearbeitung</span>
    </div>
    <div class="stat-card">
      <span class="stat-number" style="color: var(--success);"><%= stats.closed %></span>
      <span class="stat-label">Abgeschlossen</span>
    </div>
    <div class="stat-card">
      <span class="stat-number" style="color: var(--danger);"><%= stats.unassigned %></span>
      <span class="stat-label">Nicht zugewiesen</span>
    </div>
  </div>

  <!-- Filter Bar -->
  <div class="filter-bar">
    <form action="<%= url('/hausmeister/dashboard') %>" method="GET" class="filter-form">
      <input type="hidden" name="view" value="<%= filters.view %>">

      <div class="filter-group">
        <label for="status">Status</label>
        <select id="status" name="status" class="form-control">
          <option value="">Alle Status</option>
          <option value="offen" <%= filters.status === 'offen' ? 'selected' : '' %>>Offen</option>
          <option value="in_bearbeitung" <%= filters.status === 'in_bearbeitung' ? 'selected' : '' %>>In Bearbeitung</option>
          <% if (showClosed) { %>
          <option value="abgeschlossen" selected>Abgeschlossen</option>
          <% } %>
        </select>
      </div>

      <div class="filter-group">
        <label for="category_id">Kategorie</label>
        <select id="category_id" name="category_id" class="form-control">
          <option value="">Alle Kategorien</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat.id %>" <%= filters.category_id == cat.id ? 'selected' : '' %>><%= cat.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group">
        <label for="employee_id">Zugewiesener Mitarbeiter</label>
        <select id="employee_id" name="employee_id" class="form-control">
          <option value="">Alle Mitarbeiter</option>
          <option value="unassigned" <%= filters.employee_id === 'unassigned' ? 'selected' : '' %>>-- Nicht zugewiesen --</option>
          <% employees.forEach(emp => { %>
            <option value="<%= emp.id %>" <%= filters.employee_id == emp.id ? 'selected' : '' %>><%= emp.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="filter-group" style="flex: 2;">
        <label for="search">Suchbegriff</label>
        <input type="text" id="search" name="search" class="form-control" placeholder="Ticketnummer, Name, Ort..." value="<%= filters.search %>">
      </div>

      <div>
        <button type="submit" class="btn btn-primary" style="padding: 0.65rem 1rem;">Filtern</button>
        <a href="<%= url('/hausmeister/dashboard') %>?view=<%= filters.view %>" class="btn btn-secondary" style="padding: 0.65rem 1rem;">Zurücksetzen</a>
      </div>
    </form>
  </div>

  <!-- Tickets Table -->
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Nr.</th>
          <th>Datum</th>
          <th>Status</th>
          <th>Kategorie</th>
          <th>Ort / Raum</th>
          <th>Meldende(r)</th>
          <th>Zugewiesen an</th>
          <th style="text-align: right;">Aktion</th>
        </tr>
      </thead>
      <tbody>
        <% if (tickets.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align: center; padding: 2rem; color: var(--text-muted);">
              Keine Tickets für die gewählten Filter gefunden.
            </td>
          </tr>
        <% } %>
        <% tickets.forEach(t => { %>
          <%
            const redirectBack = url('/hausmeister/dashboard') + '?view=' + filters.view
              + (filters.category_id ? '&category_id=' + filters.category_id : '')
              + (filters.employee_id ? '&employee_id=' + filters.employee_id : '')
              + (filters.search ? '&search=' + encodeURIComponent(filters.search) : '');
          %>
          <tr>
            <td>
              <a href="<%= url('/hausmeister/tickets/' + t.id) %>" style="font-weight: 700; color: var(--primary); text-decoration: none;">
                <%= t.ticket_number %>
              </a>
            </td>
            <td style="font-size: 0.85rem; color: var(--text-muted); white-space: nowrap;">
              <%= new Date(t.created_at).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </td>
            <td>
              <span class="badge badge-<%= t.status %>">
                <%= t.status === 'offen' ? 'Offen' : (t.status === 'in_bearbeitung' ? 'In Bearbeitung' : 'Abgeschlossen') %>
              </span>
            </td>
            <td><%= t.category_name_snapshot %></td>
            <td><strong><%= t.location %></strong></td>
            <td>
              <div><%= t.submitter_name %></div>
              <div style="font-size: 0.8rem; color: var(--text-muted);"><%= t.submitter_email %></div>
            </td>
            <td>
              <% if (t.status !== 'abgeschlossen' && currentRole !== 'admin') { %>
              <!-- Fast Inline Employee Assignment -->
              <form action="<%= url('/hausmeister/tickets/' + t.id + '/assign-fast') %>" method="POST" style="margin: 0;">
                <input type="hidden" name="redirect_back" value="<%= redirectBack %>">
                <select name="employee_id" onchange="this.form.submit()" class="form-control" style="font-size: 0.85rem; padding: 0.3rem 0.5rem; min-width: 140px;">
                  <option value="">-- Nicht zugewiesen --</option>
                  <% employees.forEach(emp => { %>
                    <option value="<%= emp.id %>" <%= t.assigned_employee_id == emp.id ? 'selected' : '' %>>
                      <%= emp.name %> <%= !emp.is_active ? '(Inaktiv)' : '' %>
                    </option>
                  <% }); %>
                </select>
              </form>
              <% } else { %>
                <span style="font-size: 0.85rem; color: var(--text-muted);"><%= t.assigned_employee_name || '—' %></span>
              <% } %>
            </td>
            <td style="text-align: right; white-space: nowrap;">
              <a href="<%= url('/hausmeister/tickets/' + t.id) %>" class="btn btn-secondary btn-sm" style="margin-right: 0.3rem;">
                Details →
              </a>
              <!-- Quick Status Toggle (nur für Hausmeister, nicht für Admin) -->
              <% if (currentRole !== 'admin') { %>
              <form action="<%= url('/hausmeister/tickets/' + t.id + '/quick-status') %>" method="POST" style="display: inline; margin: 0;">
                <input type="hidden" name="redirect_back" value="<%= redirectBack %>">
                <% if (t.status !== 'abgeschlossen') { %>
                  <input type="hidden" name="new_status" value="abgeschlossen">
                  <button type="submit" class="btn btn-sm"
                    style="background: var(--success); color: #fff; border: none; cursor: pointer;"
                    title="Ticket abschließen"
                    onclick="return confirm('Ticket <%= t.ticket_number %> als abgeschlossen markieren?')">
                    ✓ Schließen
                  </button>
                <% } else { %>
                  <input type="hidden" name="new_status" value="offen">
                  <button type="submit" class="btn btn-sm"
                    style="background: var(--warning); color: #fff; border: none; cursor: pointer;"
                    title="Ticket wieder öffnen"
                    onclick="return confirm('Ticket <%= t.ticket_number %> wieder öffnen?')">
                    ↩ Öffnen
                  </button>
                <% } %>
              </form>
              <% } %>
            </td>

          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
